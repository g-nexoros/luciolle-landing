---
import '../styles/global.css';
import { Analytics } from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title = 'Luciolle – Le cahier journal des enseignants',
  description = 'Luciolle permet aux enseignants de maternelle et de primaire de planifier, rédiger et visualiser leur cahier journal en quelques minutes.',
  canonicalURL = Astro.url.href,
  ogImage = 'https://luciolle.fr/og.png',
} = Astro.props;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />

    <!-- Open Graph (partages réseaux / WhatsApp / Slack) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Luciolle" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Police Inter locale — pas de requête externe, LCP optimisé -->

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Luciolle",
        "description": "Cahier journal numérique pour enseignants de maternelle et primaire. Planifiez, rédigez et visualisez votre cahier journal en quelques minutes.",
        "url": "https://luciolle.fr",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": "4.99",
          "priceCurrency": "EUR",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "4.99",
            "priceCurrency": "EUR",
            "unitText": "MONTH"
          }
        },
        "audience": {
          "@type": "EducationalAudience",
          "educationalRole": "teacher"
        },
        "inLanguage": "fr"
      },
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Luciolle",
        "url": "https://luciolle.fr",
        "logo": "https://luciolle.fr/favicon.svg",
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "contact@luciolle.fr",
          "contactType": "customer support"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Luciolle",
        "url": "https://luciolle.fr",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://luciolle.fr/blog?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      }
    ])} />

    <Analytics />
  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Inter';
    font-display: swap;
  }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
