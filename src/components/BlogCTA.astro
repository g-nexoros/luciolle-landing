---
export interface Props {
  context?: string;
}
const { context = "Arrêtez de chercher un modèle — créez votre cahier journal directement dans Luciolle en 5 minutes." } = Astro.props;
---

<div class="not-prose my-10 rounded-2xl overflow-hidden border border-[#157f86]/20" style="background: linear-gradient(135deg, #f0fafa 0%, #e6f4f4 100%);">
  <div class="p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-5">
    <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background: #157f86;">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>
    </div>
    <div class="flex-1">
      <p class="font-bold text-gray-900 mb-1">Luciolle — Cahier journal numérique</p>
      <p class="text-sm text-gray-600 leading-relaxed">{context}</p>
    </div>
    <a
      href="https://luciolle.app"
      target="_blank"
      rel="noopener"
      class="flex-shrink-0 px-5 py-2.5 rounded-xl text-white font-semibold text-sm transition-colors hover:opacity-90 whitespace-nowrap"
      style="background: #157f86;"
    >
      Essayer gratuitement →
    </a>
  </div>
  <div class="px-6 sm:px-8 pb-4 flex items-center gap-4 flex-wrap">
    <span class="text-xs text-gray-400">✓ 1 mois gratuit</span>
    <span class="text-xs text-gray-400">✓ Sans carte bancaire</span>
    <span class="text-xs text-gray-400">✓ 4,99€/mois ensuite</span>
  </div>
</div>
