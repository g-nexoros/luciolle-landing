---
const { currentPath = '' } = Astro.props;
const nav = [
  { href: '/prix', label: 'Tarifs' },
  { href: '/fonctionnalites', label: 'Fonctionnalités' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/logo-icon.svg" alt="Luciolle" class="h-7 w-auto" />
      <span class="text-xl font-bold text-[#157f86]">Luciolle</span>
    </a>
    <nav class="hidden sm:flex items-center gap-6 text-sm">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class={`font-medium transition-colors ${currentPath === href ? 'text-[#157f86]' : 'text-gray-500 dark:text-gray-400 hover:text-[#157f86]'}`}
        >
          {label}
        </a>
      ))}
    </nav>
    <a href="/#waitlist" class="px-4 py-2 rounded-lg text-white font-medium text-sm bg-[#157f86] hover:bg-[#0f6068] transition-colors shrink-0">
      Être prévenu(e)
    </a>
  </div>
</header>
