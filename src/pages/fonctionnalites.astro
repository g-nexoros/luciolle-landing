---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout
  title="Fonctionnalités – Luciolle, cahier journal numérique enseignants"
  description="Découvrez toutes les fonctionnalités de Luciolle : vue semaine, modèles réutilisables, stats par matière, export PDF et sauvegarde automatique."
>
  <Header currentPath="/fonctionnalites" />

  <main class="max-w-5xl mx-auto px-6 py-20">

    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-6" style="background:#e6f4f4;color:#157f86;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Tout ce dont vous avez besoin
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-gray-50 mb-4">
        Un cahier journal <span class="text-[#157f86]">pensé pour vous</span>
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
        Luciolle remplace le cahier papier et les fichiers Excel par une interface simple, rapide et accessible partout.
      </p>
    </div>

    <!-- Fonctionnalités principales -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {[
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`,
          title: 'Vue semaine & mois',
          desc: "Visualisez toute votre semaine en un coup d'œil. Naviguez entre les jours, semaines et mois en un clic.",
          color: '#157f86',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>`,
          title: 'Semaine type',
          desc: "Créez un modèle de semaine type et appliquez-le en un clic. Ne repartez jamais de zéro.",
          color: '#3b82f6',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="M15 2v6"/><path d="M9 2v6"/><path d="m9 14 2 2 4-4"/></svg>`,
          title: 'Duplication en 1 clic',
          desc: "Dupliquez une journée entière ou une semaine complète. Modifiez seulement ce qui change.",
          color: '#8b5cf6',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>`,
          title: 'Stats par matière',
          desc: "Suivez le volume horaire par discipline sur le trimestre. Identifiez les déséquilibres facilement.",
          color: '#f59e0b',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>`,
          title: 'Export PDF',
          desc: "Exportez votre cahier journal en PDF à tout moment pour l'imprimer ou le présenter à l'inspection.",
          color: '#E8604A',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>`,
          title: 'Sauvegarde automatique',
          desc: "Vos données sont sauvegardées en temps réel. Accédez à votre cahier depuis n'importe quel appareil.",
          color: '#10b981',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>`,
          title: 'Périodes scolaires',
          desc: "Renseignez vos vacances et jours fériés. Ils s'affichent dans votre planning pour éviter les oublis.",
          color: '#6366f1',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
          title: 'Données sécurisées',
          desc: "Vos données sont chiffrées et hébergées en Europe, conformément au RGPD.",
          color: '#157f86',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>`,
          title: 'Multi-appareils',
          desc: "Ordinateur, tablette ou smartphone : Luciolle s'adapte à tous les écrans, sans installation.",
          color: '#f59e0b',
        },
      ].map(({ icon, title, desc, color }) => (
        <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={`background:${color}18;color:${color}`} set:html={icon} />
          <h2 class="font-bold text-gray-900 dark:text-white mb-2">{title}</h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center rounded-3xl p-12" style="background:linear-gradient(135deg,#157f86 0%,#0d5e63 100%);">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">Prêt à gagner du temps ?</h2>
      <p class="text-white/70 mb-8">Rejoignez la liste d'attente — 1 mois gratuit à l'ouverture, sans CB.</p>
      <a href="/#waitlist" class="inline-block px-8 py-3 rounded-xl font-semibold text-sm transition-opacity hover:opacity-90" style="background:white;color:#157f86;">
        Être prévenu(e) en avant-première →
      </a>
    </div>

  </main>

  <footer class="border-t border-gray-100 dark:border-gray-800 px-6 py-8 mt-16">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <a href="/" class="font-bold text-[#157f86]">Luciolle</a>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="/prix" class="hover:text-[#157f86] transition-colors">Tarifs</a>
        <a href="/blog" class="hover:text-[#157f86] transition-colors">Blog</a>
        <a href="/faq" class="hover:text-[#157f86] transition-colors">FAQ</a>
        <a href="/mentions-legales" class="hover:text-[#157f86] transition-colors">Mentions légales</a>
        <a href="mailto:contact@luciolle.fr" class="hover:text-[#157f86] transition-colors">Contact</a>
      </div>
      <span>© 2026 Luciolle</span>
    </div>
  </footer>
</Layout>
