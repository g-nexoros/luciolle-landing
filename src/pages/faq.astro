---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const faqs = [
  {
    cat: 'Général',
    items: [
      { q: "Qu'est-ce que Luciolle ?", a: "Luciolle est un cahier journal numérique conçu pour les enseignants de maternelle (TPS, PS, MS, GS) et de primaire (CP, CE1, CE2, CM1, CM2). Il remplace le cahier papier et les fichiers Excel par une interface simple et accessible partout." },
      { q: "Pour quels niveaux est conçu Luciolle ?", a: "Luciolle est conçu pour tous les enseignants du premier degré : maternelle (TPS, PS, MS, GS) et élémentaire (CP, CE1, CE2, CM1, CM2). Il s'adapte aussi aux classes multi-niveaux jusqu'à 4 niveaux par classe." },
      { q: "Puis-je utiliser Luciolle avec une classe multi-niveaux ?", a: "Oui. Luciolle gère jusqu'à 4 niveaux par classe (TPS, PS, MS, GS, CP, CE1, CE2, CM1, CM2). Les séances de chaque niveau s'affichent côte à côte dans le planning — une fonctionnalité rare chez les outils concurrents." },
      { q: "Luciolle est-il adapté aux enseignants en maternelle ?", a: "Oui, tous les niveaux maternelle sont supportés (TPS, PS, MS, GS), avec des activités adaptées (accueil, ateliers, motricité, sieste…)." },
    ]
  },
  {
    cat: 'Tarifs & Essai',
    items: [
      { q: "Luciolle est-il gratuit ?", a: "Luciolle propose 1 mois d'essai gratuit, sans carte bancaire requise. Après cette période, l'abonnement est à 4,99€/mois sans engagement." },
      { q: "Puis-je annuler mon abonnement ?", a: "Oui, à tout moment depuis votre espace personnel, sans pénalité ni frais. La résiliation prend effet à la fin de la période en cours." },
      { q: "Y a-t-il une réduction pour les écoles ?", a: "Nous préparons une offre établissement. Contactez-nous à contact@luciolle.fr pour en savoir plus." },
    ]
  },
  {
    cat: 'Fonctionnalités',
    items: [
      { q: "Sur quels appareils fonctionne Luciolle ?", a: "Luciolle est une application web accessible sur tous les appareils : ordinateur, tablette et smartphone. Aucune installation requise, ça fonctionne directement dans le navigateur." },
      { q: "Puis-je exporter mon cahier journal en PDF ?", a: "Oui, Luciolle permet d'exporter votre cahier journal en PDF à tout moment pour l'imprimer ou le présenter lors d'une inspection." },
      { q: "Peut-on créer une semaine type réutilisable ?", a: "Oui, c'est l'une des fonctionnalités phares de Luciolle. Créez votre modèle de semaine type une fois, puis appliquez-le en un clic sur n'importe quelle semaine." },
      { q: "Peut-on dupliquer une journée entière ?", a: "Oui, vous pouvez dupliquer une journée ou une semaine complète en un clic, puis modifier uniquement ce qui change." },
      { q: "Mon IEN acceptera-t-il un cahier journal numérique ?", a: "Oui. Luciolle vous permet d'exporter votre cahier journal en PDF soigné, imprimable et présentable lors d'une inspection. Le format est accepté par l'Éducation nationale. Plusieurs enseignants ont présenté leur cahier Luciolle lors d'inspections sans aucune difficulté." },
      { q: "J'ai déjà Excel ou Word, pourquoi changer ?", a: "Excel et Word demandent 30 à 45 minutes par semaine pour maintenir un cahier journal présentable — sans modèles réutilisables, sans statistiques, sans export PDF automatique. Luciolle est conçu spécifiquement pour les enseignants : tout est prêt, rien à formater. La plupart récupèrent leurs soirées dès la première semaine." },
    ]
  },
  {
    cat: 'Données & Sécurité',
    items: [
      { q: "Mes données sont-elles sécurisées ?", a: "Oui, toutes vos données sont chiffrées et sauvegardées automatiquement sur des serveurs sécurisés en Europe, conformément au RGPD." },
      { q: "Puis-je récupérer mes données ?", a: "Oui, vous pouvez exporter vos données à tout moment depuis votre espace personnel. Vos données vous appartiennent." },
      { q: "Luciolle respecte-t-il le RGPD ?", a: "Oui, Luciolle est conforme au RGPD. Nous ne vendons jamais vos données et vous pouvez demander leur suppression à tout moment en écrivant à contact@luciolle.fr." },
    ]
  },
  {
    cat: 'Support',
    items: [
      { q: "Comment contacter le support ?", a: "Écrivez-nous à contact@luciolle.fr ou via le formulaire de contact. Nous répondons sous 24h en semaine." },
      { q: "Y a-t-il une aide pour prendre en main Luciolle ?", a: "Oui, un guide de démarrage est disponible dans l'application. Nous proposons aussi des tutoriels vidéo sur notre blog." },
    ]
  },
];
---
<Layout
  title="FAQ – Questions fréquentes sur Luciolle | Cahier journal numérique"
  description="Toutes les réponses à vos questions sur Luciolle : fonctionnalités, tarifs, essai gratuit, sécurité des données et support."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.flatMap(cat => cat.items.map(({ q, a }) => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": { "@type": "Answer", "text": a }
    })))
  })} />

  <Header currentPath="/faq" />

  <main class="max-w-3xl mx-auto px-6 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-50 mb-3">
        Questions fréquentes
      </h1>
      <p class="text-gray-500 dark:text-gray-400">
        Tout ce que vous voulez savoir sur Luciolle.
        Autre chose ? <a href="/contact" class="text-[#157f86] hover:underline">Contactez-nous</a>.
      </p>
    </div>

    <div class="space-y-10">
      {faqs.map(({ cat, items }) => (
        <section>
          <h2 class="text-xs font-bold uppercase tracking-widest mb-4" style="color:#157f86;">{cat}</h2>
          <div class="space-y-2">
            {items.map(({ q, a }) => (
              <details class="group border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-semibold text-gray-900 dark:text-white text-sm hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors select-none">
                  {q}
                  <svg class="shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="px-5 pb-5 text-sm text-gray-500 dark:text-gray-400 leading-relaxed border-t border-gray-100 dark:border-gray-800 pt-4">
                  {a}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-16 text-center rounded-2xl p-10" style="background: linear-gradient(135deg, #157f86 0%, #0d5e63 100%);">
      <p class="font-extrabold text-white text-xl mb-2">Convaincu ? Essayez gratuitement.</p>
      <p class="text-sm mb-6" style="color: rgba(255,255,255,0.75);">1 mois offert · Sans carte bancaire · Résiliable à tout moment.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="https://luciolle.app" target="_blank" rel="noopener" class="inline-block px-7 py-3 rounded-xl font-semibold text-sm transition-opacity hover:opacity-90" style="background: #E8604A; color: white;">
          Essayer gratuitement →
        </a>
        <a href="/contact" class="inline-block px-7 py-3 rounded-xl font-semibold text-sm transition-colors" style="background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3);">
          Poser une question
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
