---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout
  title="Tarifs Luciolle – Cahier journal numérique pour enseignants"
  description="Luciolle à 2,99€/mois sans engagement. 1 mois gratuit sans carte bancaire. Cahier journal numérique pour enseignants de maternelle et primaire."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Luciolle",
    "url": "https://luciolle.fr",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Web",
    "description": "Cahier journal numérique pour enseignants de maternelle et primaire",
    "offers": [
      {
        "@type": "Offer",
        "name": "Abonnement mensuel",
        "price": "2.99",
        "priceCurrency": "EUR",
        "billingIncrement": "P1M",
        "description": "Accès complet à Luciolle, sans engagement"
      },
      {
        "@type": "Offer",
        "name": "Abonnement annuel",
        "price": "49.99",
        "priceCurrency": "EUR",
        "billingIncrement": "P1Y",
        "description": "Accès complet à Luciolle, 2 mois offerts"
      }
    ]
  })} />

  <Header currentPath="/prix" />

  <main class="max-w-5xl mx-auto px-6 py-20">

    <!-- En-tête -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-6" style="background: #e6f4f4; color: #157f86;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Tarifs simples
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-gray-50 mb-4">
        Un prix juste pour les <span class="text-[#157f86]">enseignants</span>
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        1 mois gratuit sans carte bancaire. Résiliable à tout moment, sans engagement.
      </p>
    </div>

    <!-- Cartes tarifs -->
    <div class="grid sm:grid-cols-2 gap-8 max-w-3xl mx-auto mb-16">

      <!-- Mensuel -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-3xl p-8 flex flex-col">
        <div class="mb-6">
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">Mensuel</p>
          <div class="flex items-end gap-2">
            <span class="text-5xl font-extrabold text-gray-900 dark:text-white">2,99</span>
            <span class="text-xl font-semibold text-gray-400 mb-1">€/mois</span>
          </div>
          <p class="text-sm text-gray-400 mt-1">Sans engagement · résiliable à tout moment</p>
        </div>
        <ul class="space-y-3 flex-1 mb-8">
          {[
            'Cahier journal numérique complet',
            'Fiches pédagogiques',
            'Emploi du temps',
            'Double-niveau (ex : CM1/CM2)',
            'Groupes d\'élèves avec couleurs',
            'Semaine type & duplication en 1 clic',
            'Vue semaine, mois & liste',
            'Statistiques par matière',
            'Export PDF',
            'Mode sombre · tous vos appareils',
            'Mises à jour incluses',
          ].map((f) => (
            <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
              <svg class="mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#157f86" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>
        <a href="https://luciolle.app" target="_blank" rel="noopener" class="block text-center py-3 rounded-xl border-2 font-semibold text-sm transition-colors" style="border-color: #157f86; color: #157f86;" onmouseover="this.style.background='#157f86';this.style.color='white'" onmouseout="this.style.background='transparent';this.style.color='#157f86'">
          Essayer gratuitement →
        </a>
      </div>

      <!-- Annuel — recommandé -->
      <div class="relative rounded-3xl p-8 flex flex-col text-white" style="background: linear-gradient(135deg, #157f86 0%, #0d5e63 100%);">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
          <span class="px-4 py-1 rounded-full text-xs font-bold" style="background: #E8604A; color: white;">MEILLEURE OFFRE</span>
        </div>
        <div class="mb-6">
          <p class="text-sm font-medium opacity-70 mb-2">Annuel</p>
          <div class="flex items-end gap-1">
            <span class="text-5xl font-extrabold">29,99</span>
            <span class="text-xl font-semibold opacity-70 mb-1">€/an</span>
          </div>
          <p class="text-sm opacity-60 mt-1">soit 4,17€/mois · <span class="font-semibold opacity-90">2 mois offerts</span></p>
        </div>
        <ul class="space-y-3 flex-1 mb-8">
          {[
            'Tout le plan Mensuel inclus',
            '2 mois offerts par rapport au mensuel',
            'Accès prioritaire aux nouvelles fonctions',
            'Support par email prioritaire',
          ].map((f) => (
            <li class="flex items-start gap-2 text-sm opacity-90">
              <svg class="mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>
        <a href="https://luciolle.app" target="_blank" rel="noopener" class="block text-center py-3 rounded-xl font-semibold text-sm transition-opacity hover:opacity-90" style="background: white; color: #157f86;">
          Essayer gratuitement →
        </a>
      </div>
    </div>

    <!-- Mois gratuit -->
    <div class="text-center bg-gray-50 dark:bg-gray-900 rounded-2xl p-8 max-w-2xl mx-auto mb-16">
      <div class="text-3xl mb-3">🎁</div>
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">1 mois gratuit pour commencer</h2>
      <p class="text-gray-500 dark:text-gray-400 text-sm">
        Pas de carte bancaire requise. Testez Luciolle pendant 1 mois complet, sans risque.
        Si vous n'êtes pas convaincu, vous ne payez rien.
      </p>
    </div>

    <!-- FAQ prix -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">Questions fréquentes</h2>
      <div class="space-y-4">
        {[
          { q: 'Puis-je annuler à tout moment ?', a: 'Oui, sans engagement ni frais. Vous pouvez résilier depuis votre espace personnel en quelques clics.' },
          { q: 'Mes données sont-elles sauvegardées ?', a: 'Oui, toutes vos données sont sauvegardées automatiquement et accessibles depuis n\'importe quel appareil.' },
          { q: 'Y a-t-il une réduction pour les écoles ou équipes ?', a: 'Nous préparons une offre établissement. Contactez-nous à contact@luciolle.fr pour en savoir plus.' },
          { q: 'Le prix inclut-il les mises à jour ?', a: 'Oui, toutes les mises à jour et nouvelles fonctionnalités sont incluses dans votre abonnement, sans frais supplémentaires.' },
        ].map(({ q, a }) => (
          <div class="border border-gray-100 dark:border-gray-800 rounded-2xl p-5">
            <p class="font-semibold text-gray-900 dark:text-white text-sm mb-2">{q}</p>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </div>

  </main>

  <Footer />
</Layout>
