        <input type="email" name="email" placeholder="votre@email.fr" required class="flex-1 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#157f86]/40" />
