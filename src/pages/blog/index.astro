---
import Layout from '../../layouts/Layout.astro';

const allFiles = import.meta.glob('./*.astro');
const articles = Object.keys(allFiles)
  .map((path) => path.replace('./', '').replace('.astro', ''))
  .filter((slug) => slug !== 'index')
  .sort((a, b) => a.localeCompare(b));
---

<Layout
  title="Blog Luciolle – Ressources cahier journal numérique enseignant"
  description="Guides et conseils pratiques sur le cahier journal numérique pour enseignants de maternelle et primaire. Modèles, méthodes et astuces pour gagner du temps."
>
  <header class="border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-[#1B82B6]">Luciolle</a>
      <a href="/#waitlist" class="px-4 py-2 rounded-lg text-white font-medium text-sm bg-[#1B82B6] hover:bg-[#1566a0] transition-colors">
        Être prévenu(e)
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-50 mb-4">
        Ressources pour les enseignants
      </h1>
      <p class="text-gray-500 dark:text-gray-400 text-lg max-w-2xl">
        Guides pratiques sur le cahier journal numérique pour maternelle et primaire : méthodes, modèles et conseils pour gagner du temps chaque semaine.
      </p>
      <p class="text-sm text-gray-400 mt-2">{articles.length} articles disponibles</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map((slug) => {
        const title = slug
          .split('-')
          .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(' ');
        return (
          <a
            href={`/blog/${slug}`}
            class="block bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#1B82B6]/40 hover:shadow-md transition-all group"
          >
            <h2 class="font-semibold text-gray-900 dark:text-gray-100 text-sm group-hover:text-[#1B82B6] transition-colors leading-snug">
              {title}
            </h2>
            <span class="text-xs text-[#1B82B6] mt-2 inline-block">Lire l'article →</span>
          </a>
        );
      })}
    </div>
  </main>

  <footer class="border-t border-gray-100 dark:border-gray-800 px-6 py-8 mt-16">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <a href="/" class="font-bold text-[#1B82B6]">Luciolle</a>
      <div class="flex gap-6">
        <a href="mailto:contact@luciolle.fr" class="hover:text-[#1B82B6] transition-colors">Contact</a>
        <a href="/blog" class="hover:text-[#1B82B6] transition-colors">Blog</a>
      </div>
      <span>© 2026 Luciolle</span>
    </div>
  </footer>
</Layout>
