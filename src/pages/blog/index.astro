---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    slug: 'cahier-journal-numerique-enseignant',
    category: 'Guide',
    title: 'Cahier journal numérique pour enseignant : le guide complet',
    excerpt: 'Tout ce qu\'il faut savoir pour passer au cahier journal numérique et gagner du temps chaque semaine.',
    date: '2026-05-20',
  },
  {
    slug: 'cahier-journal-maternelle',
    category: 'Maternelle',
    title: 'Cahier journal maternelle : structurer son planning PS MS GS',
    excerpt: 'Comment organiser son cahier journal en maternelle pour toutes les sections, de la PS à la GS.',
    date: '2026-05-27',
  },
  {
    slug: 'modele-cahier-journal-primaire',
    category: 'Primaire',
    title: 'Modèle de cahier journal pour le primaire : CP, CE1, CE2, CM1, CM2',
    excerpt: 'Un modèle de cahier journal adapté à chaque niveau du primaire pour ne plus repartir de zéro.',
    date: '2026-06-03',
  },
];
---

<Layout
  title="Blog Luciolle – Ressources cahier journal numérique enseignant"
  description="Guides et conseils pratiques sur le cahier journal numérique pour enseignants de maternelle et primaire. Modèles, méthodes et astuces pour gagner du temps."
>
  <!-- HEADER -->
  <header class="border-b border-gray-100 bg-white sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-[#4F86C6]">Luciolle</a>
      <a href="/#waitlist" class="px-4 py-2 rounded-lg text-white font-medium text-sm bg-[#4F86C6] hover:bg-[#3a6fad] transition-colors">
        Être prévenu(e)
      </a>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-16">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 mb-4">
        Ressources pour les enseignants
      </h1>
      <p class="text-gray-500 text-lg max-w-2xl">
        Guides pratiques sur le cahier journal numérique pour maternelle et primaire : méthodes, modèles et conseils pour gagner du temps chaque semaine.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
        <a href={`/blog/${article.slug}`} class="block bg-white border border-gray-100 rounded-2xl p-6 hover:border-[#4F86C6]/40 hover:shadow-md transition-all group">
          <span class="inline-block text-xs font-semibold text-[#4F86C6] bg-[#EBF3FB] px-2 py-0.5 rounded-full mb-3">{article.category}</span>
          <h2 class="font-bold text-gray-900 mb-3 text-base group-hover:text-[#4F86C6] transition-colors leading-snug">{article.title}</h2>
          <p class="text-sm text-gray-500 mb-4 leading-relaxed">{article.excerpt}</p>
          <span class="text-xs text-gray-400">{new Date(article.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-gray-100 px-6 py-8 mt-16">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <a href="/" class="font-bold text-[#4F86C6]">Luciolle</a>
      <div class="flex gap-6">
        <a href="mailto:contact@luciolle.fr" class="hover:text-[#4F86C6] transition-colors">Contact</a>
        <a href="/blog" class="hover:text-[#4F86C6] transition-colors">Blog</a>
      </div>
      <span>© 2026 Luciolle</span>
    </div>
  </footer>
</Layout>
