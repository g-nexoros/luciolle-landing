---
import Layout from '../layouts/Layout.astro';

const days = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven'];
const blockColors = ['#1B82B6', '#60a5fa', '#f59e0b', '#10b981', '#8b5cf6'];

const mockupSlots = [
  [{ label: 'Français', time: '8h30' }, { label: 'Maths', time: '10h00' }, { label: 'EPS', time: '14h00' }],
  [{ label: 'Maths', time: '8h30' }, { label: 'Sciences', time: '10h00' }, { label: 'Arts', time: '14h00' }],
  [{ label: 'Lecture', time: '9h00' }, { label: 'Maths', time: '10h30' }, { label: 'Histoire', time: '14h00' }],
  [{ label: 'Français', time: '8h30' }, { label: 'EPS', time: '10h00' }, { label: 'Sciences', time: '14h00' }],
  [{ label: 'Maths', time: '8h30' }, { label: 'Français', time: '10h00' }, { label: 'Arts', time: '14h00' }],
];

const features = [
  {
    icon: 'calendar',
    title: 'Vue semaine & mois',
    desc: "Visualisez toute votre semaine en un coup d'œil. Naviguez entre les jours, ajoutez vos séances et imprimez votre cahier en PDF.",
  },
  {
    icon: 'copy',
    title: 'Semaine type & duplication',
    desc: "Créez un modèle de semaine type et appliquez-le en un clic. Dupliquez une journée entière pour ne jamais repartir de zéro.",
  },
  {
    icon: 'barchart',
    title: 'Stats par matière',
    desc: "Suivez le volume horaire par discipline sur le trimestre. Identifiez les déséquilibres et ajustez votre programme facilement.",
  },
  {
    icon: 'calendarx',
    title: 'Périodes scolaires',
    desc: "Renseignez vos vacances et jours fériés pour les visualiser directement dans votre planning et éviter les oublis.",
  },
];

const painPoints = [
  { before: 'Cahier papier perdu ou illisible', after: 'Tout est numérique, sauvegardé, accessible' },
  { before: '30 min pour rédiger une journée', after: 'Moins de 5 min grâce aux modèles réutilisables' },
  { before: 'Recommencer à zéro chaque semaine', after: 'Modèle de semaine type applicable en un clic' },
  { before: 'Impossible de voir la progression', after: 'Statistiques par matière en temps réel' },
];
---

<Layout
  title="Luciolle – Cahier journal numérique pour enseignants"
  description="Luciolle, le cahier journal numérique pour enseignants de maternelle et primaire. Planifiez vos séances en quelques minutes. Bientôt disponible."
>
  <!-- HEADER -->
  <header class="border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-[#1B82B6]">Luciolle</a>
      <a href="#waitlist" class="px-4 py-2 rounded-lg text-white font-medium text-sm bg-[#1B82B6] hover:bg-[#1566a0] transition-colors">
        Être prévenu(e)
      </a>
    </div>
  </header>

  <main>

    <!-- HERO -->
    <section class="max-w-3xl mx-auto px-6 pt-20 pb-16 text-center">

      <!-- Badge doré "Bientôt disponible" -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-6 badge-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Bientôt disponible
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 tracking-tight text-gray-900 dark:text-gray-50">
        Le cahier journal numérique <span class="text-[#1B82B6]">des enseignants</span><br />qui gagnent du temps
      </h1>

      <p class="text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Luciolle est le cahier journal numérique pour enseignants de maternelle (PS, MS, GS) et de primaire (CP, CE1, CE2, CM1, CM2). Planifiez, rédigez et visualisez vos séances en quelques minutes.
      </p>

      <!-- WAITLIST FORM HERO -->
      <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-8 max-w-lg mx-auto">
        <p class="font-semibold text-gray-900 dark:text-gray-50 mb-1">Soyez parmi les premiers</p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
          Laissez votre email — on vous prévient en avant-première à l'ouverture.<br />
          <!-- Prix en doré -->
          <span class="font-semibold" style="color: #E17E29;">À partir de 2,99€/mois · 1 mois gratuit.</span>
        </p>
        <form id="waitlist-form-hero" class="flex flex-col sm:flex-row gap-3" action="https://formspree.io/f/mzdqzzle" method="POST">
          <input
            type="email"
            name="email"
            placeholder="votre@email.fr"
            required
            class="flex-1 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1B82B6]/40 text-sm"
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl text-white font-semibold text-sm bg-[#1B82B6] hover:bg-[#1566a0] transition-colors whitespace-nowrap"
          >
            Me prévenir →
          </button>
        </form>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-3">
          Aucun spam · Désabonnement en un clic
        </p>
      </div>
    </section>

    <!-- MOCKUP -->
    <section class="bg-gray-50 dark:bg-gray-900/50 border-y border-gray-100 dark:border-gray-800 py-16 reveal">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-center text-sm font-medium text-gray-400 dark:text-gray-500 mb-8 uppercase tracking-widest">Aperçu de l'application</p>
        <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-xl overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
            <span class="ml-3 text-xs text-gray-400 bg-white dark:bg-gray-700 rounded px-3 py-1 flex-1 max-w-xs font-mono">
              app.luciolle.fr/semaine
            </span>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <div class="h-5 w-36 bg-gray-200 dark:bg-gray-700 rounded-lg"></div>
              <div class="flex gap-2">
                <div class="h-8 w-20 bg-[#1B82B6]/20 rounded-lg"></div>
                <div class="h-8 w-8 bg-gray-100 dark:bg-gray-800 rounded-lg"></div>
              </div>
            </div>
            <div class="grid grid-cols-5 gap-3">
              {days.map((day, dayIdx) => (
                <div>
                  <div class="text-xs font-semibold text-gray-400 dark:text-gray-500 mb-2 text-center uppercase tracking-wide">{day}</div>
                  <div class="space-y-2">
                    {mockupSlots[dayIdx].map((slot, blockIdx) => {
                      const color = blockColors[(dayIdx + blockIdx) % blockColors.length];
                      return (
                        <div
                          class="h-14 rounded-xl px-2.5 py-2 flex flex-col justify-center gap-0.5"
                          style={`background-color: ${color}20; border-left: 3px solid ${color};`}
                        >
                          <span class="text-xs font-semibold truncate" style={`color: ${color};`}>{slot.label}</span>
                          <span class="text-[10px] text-gray-400">{slot.time}</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PAIN POINTS -->
    <section class="px-6 py-20 max-w-5xl mx-auto reveal">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-gray-900 dark:text-gray-50">
          Fini le cahier journal numérique qui prend{' '}
          <span class="text-red-400 line-through decoration-2">des heures</span>
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          Conçu avec des enseignants de maternelle (PS MS GS) et de primaire (CP CE1 CE2 CM1 CM2) pour répondre aux vrais problèmes du quotidien.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
        {painPoints.map((point, i) => (
          <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 stagger-child" style={`--stagger: ${i}`}>
            <div class="flex items-start gap-3 mb-3">
              <span class="text-red-400 text-lg leading-none mt-0.5">✗</span>
              <span class="text-sm text-gray-400 dark:text-gray-500 line-through">{point.before}</span>
            </div>
            <div class="flex items-start gap-3">
              <!-- Check en doré -->
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" style="color: #E17E29;" class="mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="text-sm font-medium text-gray-800 dark:text-gray-200">{point.after}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FEATURES -->
    <section class="bg-gray-50 dark:bg-gray-900/50 border-y border-gray-100 dark:border-gray-800 px-6 py-20 reveal">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-gray-900 dark:text-gray-50">
            Tout ce dont votre cahier journal a besoin
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
            Des outils pensés pour les enseignants de maternelle et de primaire, pas pour les développeurs.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 gap-6">
          {features.map((feature, i) => (
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl p-6 hover:border-[#1B82B6]/40 transition-colors stagger-child" style={`--stagger: ${i}`}>
              <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 icon-bg-primary">
                {feature.icon === 'calendar' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="text-[#1B82B6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>
                )}
                {feature.icon === 'copy' && (
                  <svg width="20" height="20" class="text-[#1B82B6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                )}
                {feature.icon === 'barchart' && (
                  <svg width="20" height="20" class="text-[#1B82B6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                )}
                {feature.icon === 'calendarx' && (
                  <svg width="20" height="20" class="text-[#1B82B6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><line x1="10" x2="14" y1="15" y2="19"/><line x1="14" x2="10" y1="15" y2="19"/></svg>
                )}
              </div>
              <h3 class="font-bold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{feature.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section class="px-6 py-16 max-w-5xl mx-auto reveal">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3 text-gray-900 dark:text-gray-50">
          Ressources pour les enseignants
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto text-sm">
          Conseils pratiques sur le cahier journal numérique pour maternelle et primaire.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        <!-- Badges de catégorie en doré -->
        <a href="/blog/cahier-journal-numerique-enseignant" class="block bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#1B82B6]/40 transition-colors group">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-3 badge-secondary">Guide</span>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-sm group-hover:text-[#1B82B6] transition-colors">Cahier journal numérique pour enseignant : le guide complet</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">Tout ce qu'il faut savoir pour passer au cahier journal numérique et gagner du temps chaque semaine.</p>
        </a>
        <a href="/blog/cahier-journal-maternelle" class="block bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#1B82B6]/40 transition-colors group">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-3 badge-secondary">Maternelle</span>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-sm group-hover:text-[#1B82B6] transition-colors">Cahier journal maternelle : structurer son planning PS MS GS</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">Comment organiser son cahier journal en maternelle pour toutes les sections, de la PS à la GS.</p>
        </a>
        <a href="/blog/modele-cahier-journal-primaire" class="block bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#1B82B6]/40 transition-colors group">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-3 badge-secondary">Primaire</span>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-sm group-hover:text-[#1B82B6] transition-colors">Modèle de cahier journal pour le primaire : CP, CE1, CE2, CM1, CM2</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">Un modèle de cahier journal adapté à chaque niveau du primaire pour ne plus repartir de zéro.</p>
        </a>
      </div>
      <div class="text-center mt-8">
        <a href="/blog" class="text-sm text-[#1B82B6] hover:underline font-medium">Voir tous les articles →</a>
      </div>
    </section>

    <!-- WAITLIST FINALE -->
    <section id="waitlist" class="px-6 py-24 max-w-2xl mx-auto text-center reveal">
      <!-- Icône en doré -->
      <div class="flex justify-center mb-6" style="color: #E17E29;">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" x2="6" y1="1" y2="4"/><line x1="10" x2="10" y1="1" y2="4"/><line x1="14" x2="14" y1="1" y2="4"/></svg>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3 text-gray-900 dark:text-gray-50">
        Récupérez vos soirées
      </h2>
      <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-lg mx-auto">
        Luciolle arrive bientôt. Laissez votre email pour être prévenu(e) en avant-première dès l'ouverture.
      </p>

      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-4" action="https://formspree.io/f/mzdqzzle" method="POST">
        <input
          type="email"
          name="email"
          placeholder="votre@email.fr"
          required
          class="flex-1 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1B82B6]/40 text-sm"
        />
        <button
          type="submit"
          class="px-6 py-3 rounded-xl text-white font-semibold text-sm bg-[#1B82B6] hover:bg-[#1566a0] transition-colors whitespace-nowrap"
        >
          Me prévenir →
        </button>
      </form>

      <div class="flex flex-col items-center gap-2 mt-6">
        <!-- Barre de progression en doré -->
        <div class="w-48 h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
          <div class="h-full rounded-full" style="width: 34%; background-color: #E17E29;"></div>
        </div>
        <p class="text-xs text-gray-400 dark:text-gray-500">
          <span class="font-semibold text-gray-600 dark:text-gray-300">34</span> inscrits ·
          <!-- Prix en doré -->
          <span class="font-semibold" style="color: #E17E29;">2,99€/mois</span> · 1 mois gratuit
        </p>
      </div>

      <p class="text-xs text-gray-400 dark:text-gray-500 mt-4">
        Aucun spam · Désabonnement en un clic
      </p>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="border-t border-gray-100 dark:border-gray-800 px-6 py-8">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400 dark:text-gray-600">
      <span class="font-bold text-[#1B82B6]">Luciolle</span>
      <div class="flex gap-6">
        <a href="mailto:contact@luciolle.fr" class="hover:text-[#1B82B6] transition-colors">Contact</a>
        <a href="/blog" class="hover:text-[#1B82B6] transition-colors">Blog</a>
      </div>
      <span>© 2026 Luciolle</span>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Qu'est-ce que Luciolle ?", "acceptedAnswer": { "@type": "Answer", "text": "Luciolle est un cahier journal numérique pour les enseignants de maternelle (PS, MS, GS) et de primaire (CP, CE1, CE2, CM1, CM2). Il permet de planifier, rédiger et visualiser ses séances en quelques minutes." } },
      { "@type": "Question", "name": "Combien coûte Luciolle ?", "acceptedAnswer": { "@type": "Answer", "text": "Luciolle est disponible à partir de 2,99€/mois ou 29,99€/an. Un essai gratuit de 1 mois est inclus, sans carte bancaire." } },
      { "@type": "Question", "name": "Luciolle fonctionne-t-il pour la maternelle ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui, Luciolle est conçu pour PS, MS et GS. Il s'adapte aux ateliers, rituels et séances spécifiques à la maternelle." } },
      { "@type": "Question", "name": "Puis-je exporter mon cahier journal en PDF ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui, Luciolle permet d'exporter votre cahier journal en PDF à tout moment pour l'imprimer ou le présenter lors d'une inspection." } },
      { "@type": "Question", "name": "Combien de temps faut-il pour créer son cahier journal avec Luciolle ?", "acceptedAnswer": { "@type": "Answer", "text": "Grâce aux modèles de semaine type et à la duplication de journées, la plupart des enseignants créent leur cahier journal en moins de 5 minutes par jour." } },
      { "@type": "Question", "name": "Quand Luciolle sera-t-il disponible ?", "acceptedAnswer": { "@type": "Answer", "text": "Luciolle arrive bientôt. Inscrivez-vous sur la liste d'attente pour être prévenu en avant-première à 2,99€/mois." } }
    ]
  })} />
</Layout>

<style>
  /* Badge bleu principal */
  .badge-primary { background-color: #E8F4FB; color: #1B82B6; }

  /* Badge doré secondaire */
  .badge-secondary { background-color: #FEF0E4; color: #E17E29; }

  @media (prefers-color-scheme: dark) {
    .badge-primary { background-color: #0d2d3f; color: #5BB3D8; }
    .badge-secondary { background-color: #3D1800; color: #E88525; }
    .icon-bg-primary { background-color: #0d2d3f; }
  }
  .icon-bg-primary { background-color: #E8F4FB; }

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  .stagger-child {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--stagger, 0) * 90ms);
  }
  .reveal.visible .stagger-child { opacity: 1; transform: translateY(0); }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
