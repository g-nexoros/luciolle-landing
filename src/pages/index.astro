---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const features = [
  {
    icon: 'calendar',
    title: 'Cahier journal complet',
    desc: "Séances avec matière, horaire, objectif, déroulement, observations et ressources. Statut brouillon / validé. Notes rapides depuis la vue semaine.",
  },
  {
    icon: 'copy',
    title: 'Semaine type & duplication',
    desc: "Créez un modèle de semaine type et appliquez-le en un clic. Dupliquez une journée entière pour ne jamais repartir de zéro.",
  },
  {
    icon: 'users',
    title: 'Classes multi-niveaux',
    desc: "Jusqu'à 4 niveaux par classe (TPS/PS/MS/GS, CM1/CM2…). Les séances de chaque niveau s'affichent côte à côte dans le cahier journal et la vue semaine.",
  },
  {
    icon: 'barchart',
    title: 'Statistiques & emploi du temps',
    desc: "Suivez le volume horaire par discipline sur le trimestre. Visualisez votre emploi du temps et identifiez les déséquilibres.",
  },
  {
    icon: 'file',
    title: 'Fiches pédagogiques',
    desc: "Rédigez et archivez vos fiches de préparation directement dans Luciolle, liées à vos séances du cahier journal.",
  },
  {
    icon: 'calendarx',
    title: 'Périodes & export PDF',
    desc: "Renseignez vos vacances et périodes scolaires. Exportez votre cahier journal en PDF pour l'imprimer ou le présenter en inspection.",
  },
];

const painPoints = [
  { before: 'Cahier papier perdu ou illisible', after: 'Tout est numérique, sauvegardé, accessible' },
  { before: '30 min pour rédiger une journée', after: 'Moins de 5 min grâce aux modèles réutilisables' },
  { before: 'Recommencer à zéro chaque semaine', after: 'Modèle de semaine type applicable en un clic' },
  { before: 'Impossible de voir la progression', after: 'Statistiques par matière en temps réel' },
];
---

<Layout
  title="Luciolle – Cahier journal numérique pour enseignants"
  description="Luciolle, le cahier journal numérique pour enseignants de maternelle et primaire. Planifiez vos séances en quelques minutes. 1 mois gratuit, sans carte bancaire."
>
  <Header />

  <main>

    <!-- HERO -->
    <section class="relative overflow-hidden px-6 pt-20 pb-16 text-center">
      <!-- Blobs décoratifs grands -->
      <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full opacity-20 blur-3xl pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute -bottom-20 -left-32 w-[450px] h-[450px] rounded-full opacity-20 blur-3xl pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute top-1/2 right-10 w-64 h-64 rounded-full opacity-10 blur-2xl pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute top-10 left-1/3 w-48 h-48 rounded-full opacity-10 blur-2xl pointer-events-none" style="background: #157f86;"></div>
      <!-- Points décoratifs -->
      <div class="absolute top-16 left-8 w-5 h-5 rounded-full opacity-40 pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute top-32 right-16 w-3 h-3 rounded-full opacity-30 pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute bottom-24 left-1/4 w-4 h-4 rounded-full opacity-35 pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute bottom-16 right-1/3 w-6 h-6 rounded-full opacity-25 pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute top-24 left-1/2 w-2 h-2 rounded-full opacity-50 pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute bottom-40 right-8 w-3 h-3 rounded-full opacity-40 pointer-events-none" style="background: #157f86;"></div>
      <div class="max-w-5xl mx-auto relative">

      <!-- Badges hero -->
      <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium badge-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Disponible maintenant
        </div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium" style="background:#f0f4ff;color:#3b5bdb;">
          🇫🇷 Fait en France · Indépendant
        </div>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 tracking-tight text-gray-900 dark:text-gray-50">
        Le cahier journal numérique <span class="text-[#157f86]">des enseignants</span><br />qui gagnent du temps
      </h1>

      <p class="text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Luciolle est le cahier journal numérique pour enseignants de maternelle (TPS, PS, MS, GS) et de primaire (CP, CE1, CE2, CM1, CM2). Planifiez, rédigez et visualisez vos séances en quelques minutes.
      </p>

      <!-- CTA HERO -->
      <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-8 max-w-lg mx-auto">
        <p class="font-semibold text-gray-900 dark:text-gray-50 mb-1">Commencez dès aujourd'hui</p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
          1 mois gratuit, sans carte bancaire. Résiliable à tout moment.
        </p>
        <div class="flex items-center justify-center gap-2 mb-6">
          <span class="text-2xl font-extrabold text-gray-900 dark:text-white">2,99€</span>
          <span class="text-sm text-gray-400">/mois · sans engagement</span>
        </div>
        <a
          href="https://luciolle.app"
          target="_blank"
          rel="noopener"
          class="block w-full text-center px-6 py-3 rounded-xl text-white font-semibold text-sm bg-[#157f86] hover:bg-[#0f6068] transition-colors"
        >
          Essayer gratuitement →
        </a>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-3 text-center">
          Aucune carte bancaire · 1 mois offert
        </p>
      </div>
    </div><!-- fin max-w-5xl relative -->
    </section>

    <!-- MOCKUP -->
    <section class="relative overflow-hidden bg-gray-50 dark:bg-gray-900/50 border-y border-gray-100 dark:border-gray-800 py-16 reveal">
      <div class="absolute top-4 right-4 w-3 h-3 rounded-full opacity-40 pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute bottom-4 left-8 w-4 h-4 rounded-full opacity-30 pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute top-1/2 right-6 w-2 h-2 rounded-full opacity-50 pointer-events-none" style="background: #E8604A;"></div>
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-center text-sm font-medium text-gray-400 dark:text-gray-500 mb-8 uppercase tracking-widest">Aperçu de l'application</p>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 shadow-xl overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
            <span class="ml-3 text-xs text-gray-400 bg-white dark:bg-gray-700 rounded px-3 py-1 flex-1 max-w-xs font-mono">
              luciolle.app
            </span>
          </div>
          <img src="/app-screenshot-calendar.png" alt="Aperçu du calendrier Luciolle" class="w-full" />
        </div>
      </div>
    </section>

    <!-- PAIN POINTS -->
    <section class="relative overflow-hidden px-6 py-20 max-w-5xl mx-auto reveal">
      <div class="absolute -right-10 top-10 w-48 h-48 rounded-full opacity-[0.07] blur-2xl pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute -left-10 bottom-10 w-40 h-40 rounded-full opacity-[0.07] blur-2xl pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute top-8 left-1/4 w-3 h-3 rounded-full opacity-30 pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute bottom-8 right-1/4 w-4 h-4 rounded-full opacity-25 pointer-events-none" style="background: #E8604A;"></div>
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-gray-900 dark:text-gray-50">
          Fini le cahier journal numérique qui prend{' '}
          <span class="text-red-400 line-through decoration-2">des heures</span>
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          Conçu avec des enseignants de maternelle (PS MS GS) et de primaire (CP CE1 CE2 CM1 CM2) pour répondre aux vrais problèmes du quotidien.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
        {painPoints.map((point, i) => (
          <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 stagger-child" style={`--stagger: ${i}`}>
            <div class="flex items-start gap-3 mb-3">
              <span class="text-red-400 text-lg leading-none mt-0.5">✗</span>
              <span class="text-sm text-gray-400 dark:text-gray-500 line-through">{point.before}</span>
            </div>
            <div class="flex items-start gap-3">
              <!-- Check en doré -->
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" style="color: #E8604A;" class="mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="text-sm font-medium text-gray-800 dark:text-gray-200">{point.after}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FEATURES — fond teal foncé avec bords diagonaux -->
    <section class="relative overflow-hidden px-6 py-28 reveal" style="background: #0d5e63; clip-path: polygon(0 50px, 100% 0, 100% calc(100% - 50px), 0 100%);">

      <!-- Déco blob -->
      <div class="absolute top-0 right-0 w-64 h-64 rounded-full opacity-10 blur-3xl pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full opacity-10 blur-3xl pointer-events-none" style="background: #157f86;"></div>
      <div class="max-w-5xl mx-auto relative">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-white">
            Tout ce dont votre cahier journal a besoin
          </h2>
          <p class="max-w-xl mx-auto" style="color: rgba(255,255,255,0.7);">
            Des outils pensés pour les enseignants de maternelle et de primaire.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature, i) => (
            <div class="rounded-2xl p-6 stagger-child" style={`--stagger: ${i}; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);`}>
              <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style="background: #E8604A;">
                {feature.icon === 'calendar' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>
                )}
                {feature.icon === 'copy' && (
                  <svg width="20" height="20" class="text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                )}
                {feature.icon === 'users' && (
                  <svg width="20" height="20" class="text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
                {feature.icon === 'barchart' && (
                  <svg width="20" height="20" class="text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                )}
                {feature.icon === 'file' && (
                  <svg width="20" height="20" class="text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                )}
                {feature.icon === 'calendarx' && (
                  <svg width="20" height="20" class="text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><line x1="10" x2="14" y1="15" y2="19"/><line x1="14" x2="10" y1="15" y2="19"/></svg>
                )}
              </div>
              <h3 class="font-bold text-white mb-2">{feature.title}</h3>
              <p class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.65);">{feature.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section class="relative overflow-hidden px-6 py-16 max-w-5xl mx-auto reveal">
      <div class="absolute top-6 right-8 w-5 h-5 rounded-full opacity-35 pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute bottom-6 left-6 w-3 h-3 rounded-full opacity-30 pointer-events-none" style="background: #157f86;"></div>
      <div class="absolute top-1/2 left-4 w-2 h-2 rounded-full opacity-40 pointer-events-none" style="background: #E8604A;"></div>
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3 text-gray-900 dark:text-gray-50">
          Ressources pour les enseignants
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto text-sm">
          Conseils pratiques sur le cahier journal numérique pour maternelle et primaire.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        <!-- Badges de catégorie en doré -->
        <a href="/blog/cahier-journal-numerique-enseignant" class="block bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#157f86]/40 transition-colors group">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-3 badge-secondary">Guide</span>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-sm group-hover:text-[#157f86] transition-colors">Cahier journal numérique pour enseignant : le guide complet</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">Tout ce qu'il faut savoir pour passer au cahier journal numérique et gagner du temps chaque semaine.</p>
        </a>
        <a href="/blog/cahier-journal-maternelle" class="block bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#157f86]/40 transition-colors group">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-3 badge-secondary">Maternelle</span>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-sm group-hover:text-[#157f86] transition-colors">Cahier journal maternelle : structurer son planning PS MS GS</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">Comment organiser son cahier journal en maternelle pour toutes les sections, de la PS à la GS.</p>
        </a>
        <a href="/blog/modele-cahier-journal-primaire" class="block bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-[#157f86]/40 transition-colors group">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-3 badge-secondary">Primaire</span>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-sm group-hover:text-[#157f86] transition-colors">Modèle de cahier journal pour le primaire : CP, CE1, CE2, CM1, CM2</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">Un modèle de cahier journal adapté à chaque niveau du primaire pour ne plus repartir de zéro.</p>
        </a>
      </div>
      <div class="text-center mt-8">
        <a href="/blog" class="text-sm text-[#157f86] hover:underline font-medium">Voir tous les articles →</a>
      </div>
    </section>

    <!-- COMMENT ÇA MARCHE -->
    <section class="relative overflow-hidden px-6 py-20 reveal" style="background: #f8fffe;">
      <div class="absolute top-6 right-8 w-4 h-4 rounded-full opacity-30 pointer-events-none" style="background: #E8604A;"></div>
      <div class="absolute bottom-6 left-8 w-3 h-3 rounded-full opacity-25 pointer-events-none" style="background: #157f86;"></div>
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-gray-900 dark:text-gray-50">
            Prêt en <span class="text-[#157f86]">5 minutes</span>
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
            Pas de formation, pas de configuration complexe.
          </p>
        </div>
        <div class="grid sm:grid-cols-3 gap-8 max-w-4xl mx-auto">
          {[
            { step: '1', title: 'Créez votre compte', desc: 'En 30 secondes, sans carte bancaire. Votre essai d\'un mois commence immédiatement.', icon: '👤' },
            { step: '2', title: 'Ajoutez votre classe', desc: 'Renseignez votre niveau (PS, CP, CM2…) et vos matières. Luciolle configure tout automatiquement.', icon: '🏫' },
            { step: '3', title: 'Rédigez votre première journée', desc: 'Utilisez un modèle type ou créez vos séances en quelques clics. Exportez en PDF en un clic.', icon: '📝' },
          ].map((item, i) => (
            <div class="relative text-center stagger-child" style={`--stagger: ${i}`}>
              {i < 2 && (
                <div class="hidden sm:block absolute top-8 left-full w-8 h-0.5 -ml-4 pointer-events-none" style="background: linear-gradient(to right, #157f86, transparent);"></div>
              )}
              <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-md" style="background: #157f86;">
                <span class="text-white font-extrabold text-xl">{item.step}</span>
              </div>
              <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-lg">{item.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="relative overflow-hidden px-6 py-20 max-w-3xl mx-auto reveal">
      <div class="absolute top-4 right-4 w-3 h-3 rounded-full opacity-30 pointer-events-none" style="background: #157f86;"></div>
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-gray-900 dark:text-gray-50">
          Questions fréquentes
        </h2>
      </div>
      <div class="space-y-3" id="faq">
        {[
          { q: 'Puis-je utiliser Luciolle avec une classe multi-niveaux ?', a: 'Oui. Luciolle gère jusqu\'à 4 niveaux par classe (TPS, PS, MS, GS, CP, CE1, CE2, CM1, CM2). Les séances de chaque niveau s\'affichent côte à côte dans le planning — une fonctionnalité rare chez les outils concurrents.' },
          { q: 'Luciolle est-il adapté aux enseignants en maternelle ?', a: 'Oui, tous les niveaux maternelle sont supportés (TPS, PS, MS, GS), avec des activités adaptées (accueil, ateliers, motricité, sieste…).' },
          { q: 'Dois-je entrer ma carte bancaire pour l\'essai ?', a: 'Non. L\'essai d\'un mois ne nécessite aucune carte bancaire. Vous renseignez vos informations de paiement uniquement si vous choisissez de continuer.' },
          { q: 'Pour quels niveaux est conçu Luciolle ?', a: 'Luciolle est conçu pour tous les enseignants du primaire : maternelle (TPS, PS, MS, GS) et élémentaire (CP, CE1, CE2, CM1, CM2).' },
          { q: 'Puis-je exporter mon cahier journal en PDF ?', a: 'Oui, Luciolle permet d\'exporter votre cahier journal en PDF à tout moment pour l\'imprimer ou le présenter lors d\'une inspection.' },
          { q: 'Combien de temps faut-il pour créer son cahier journal ?', a: 'Grâce aux modèles de semaine type et à la duplication, la plupart des enseignants créent leur cahier journal en moins de 5 minutes par jour.' },
          { q: 'Puis-je annuler à tout moment ?', a: 'Oui, sans justification ni pénalité. La résiliation prend effet à la fin de la période en cours.' },
        ].map((item, i) => (
          <details class="group border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden stagger-child" style={`--stagger: ${i}`}>
            <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors list-none">
              {item.q}
              <svg class="w-5 h-5 text-[#157f86] flex-shrink-0 ml-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-500 dark:text-gray-400 leading-relaxed border-t border-gray-50 dark:border-gray-800 pt-4">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA FINALE -->
