---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('erreur');
---
<Layout
  title="Contact – Luciolle, cahier journal numérique enseignants"
  description="Contactez l'équipe Luciolle pour toute question sur le cahier journal numérique pour enseignants. Réponse sous 24h."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Luciolle",
    "url": "https://luciolle.fr/contact",
    "description": "Contactez l'équipe Luciolle",
    "mainEntity": {
      "@type": "Organization",
      "name": "Luciolle",
      "email": "contact@luciolle.fr",
      "url": "https://luciolle.fr"
    }
  })} />

  <Header currentPath="/contact" />

  <main class="max-w-2xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-6" style="background: #e6f4f4;">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#157f86" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-50 mb-3">
        Contactez-nous
      </h1>
      <p class="text-gray-500 dark:text-gray-400">
        Une question, une suggestion, un bug ? On vous répond sous 24h.
      </p>
    </div>

    {sent ? (
      <div class="rounded-2xl p-8 text-center" style="background: #e6f4f4;">
        <div class="text-3xl mb-3">🎉</div>
        <p class="font-semibold text-gray-900 dark:text-white mb-1">Message envoyé !</p>
        <p class="text-sm text-gray-500">On vous répond dans les 24h.</p>
        <a href="/" class="mt-4 inline-block text-sm font-medium text-[#157f86] hover:underline">Retour à l'accueil</a>
      </div>
    ) : (
      <form
        action="https://formspree.io/f/contact@luciolle.fr"
        method="POST"
        class="space-y-5 bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-8"
      >
        <input type="hidden" name="_next" value="https://luciolle.fr/contact?sent=1" />
        <input type="text" name="_gotcha" class="hidden" />

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="name">Votre prénom</label>
          <input id="name" type="text" name="name" placeholder="Marie" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#157f86]/40 text-sm" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="email">Votre email</label>
          <input id="email" type="email" name="email" placeholder="marie@email.fr" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#157f86]/40 text-sm" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="subject">Sujet</label>
          <select id="subject" name="subject"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-[#157f86]/40 text-sm">
            <option value="question">Question sur Luciolle</option>
            <option value="suggestion">Suggestion / fonctionnalité</option>
            <option value="bug">Signaler un problème</option>
            <option value="partenariat">Partenariat / presse</option>
            <option value="autre">Autre</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Votre message..." required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#157f86]/40 text-sm resize-none"></textarea>
        </div>

        {error && (
          <div class="p-3 rounded-xl text-sm font-medium text-center" style="background: #fef0ee; color: #E8604A;">
            Une erreur est survenue. Réessayez ou écrivez directement à contact@luciolle.fr
          </div>
        )}

        <button type="submit" class="w-full py-3 rounded-xl text-white font-semibold text-sm bg-[#157f86] hover:bg-[#0f6068] transition-colors">
          Envoyer le message →
        </button>

        <p class="text-xs text-center text-gray-400">
          Ou écrivez directement à <a href="mailto:contact@luciolle.fr" class="text-[#157f86] hover:underline">contact@luciolle.fr</a>
        </p>
      </form>
    )}
  </main>

  <Footer />
</Layout>
